{
  "functions": {
    "api/track.js": {
      "maxDuration": 20
    },
    "api/track-order.js": {
      "maxDuration": 20
    },
    "api/check-shipments.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/check-shipments",
      "schedule": "15 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}